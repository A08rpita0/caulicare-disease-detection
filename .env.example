# Copy this file to .env and adjust as needed. Never commit .env.
# Every setting is optional; the defaults below are what the app uses when unset.

# --- Flask ---
# Long random string, e.g. output of: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
FLASK_DEBUG=false
PORT=5000

# --- Model ---
MODEL_PATH=models/model1.h5
# Optional URL to download the model from when MODEL_PATH does not exist
MODEL_URL=
PRELOAD_MODEL=true
MAX_UPLOAD_MB=8
# How the CNN is served:
#   auto        Keras, plus the ONNX copy when it reproduces the Keras model (checked at start-up); verified
#               ONNX then serves everything, Grad-CAM included. Needs ~100 MB more than tensorflow alone.
#   onnx        ONNX Runtime only; TensorFlow is never imported (install requirements-onnx.txt). About a fifth
#               of the memory, sub-second start-up. Refuses a model1.onnx not exported from model1.h5.
#   tensorflow  Keras only.
INFERENCE_BACKEND=auto
# Create/refresh the ONNX files after changing the model with: python scripts/export_onnx.py
ONNX_MODEL_PATH=models/model1.onnx
ONNX_THREADS=1
# Finished analyses kept in memory by the SHA-256 of the image (0 = off)
PREDICTION_CACHE_SIZE=32
# Most images accepted by POST /api/predict/batch
BATCH_MAX_IMAGES=8
# Images processed at the same time (1 is safest on small instances)
MAX_CONCURRENT_PREDICTIONS=1

# --- Similarity service (separate service: similarity_service/) ---
# Runs the cauliflower-leaf check and visual similarity search. REQUIRED for analyses:
# without it every upload is refused with "leaf check unavailable" (fail closed).
# Production: https://caulicare-similarity.onrender.com
# Local two-service setup: SIMILARITY_SERVICE_URL=http://localhost:8001
SIMILARITY_SERVICE_URL=https://caulicare-similarity.onrender.com
# Shared secret; must equal SERVICE_TOKEN in the similarity service's environment.
# The production service requires it (copy it from Render; never commit it).
# Leave empty only when the service you point at has no SERVICE_TOKEN (local).
SIMILARITY_SERVICE_TOKEN=
# Seconds to wait for the similarity service before showing "temporarily unavailable"
SIMILARITY_TIMEOUT=30
SIMILAR_RESULTS=5
# Seconds to wait for the cauliflower-leaf check (longer: the service may be waking up)
LEAF_CHECK_TIMEOUT=75

# --- Similarity service only (set in that service's environment) ---
# SERVICE_TOKEN=
# MAX_CONCURRENT_SEARCHES=1

# --- Limits / proxies ---
RATE_LIMIT_PREDICT=30/minute
RATE_LIMIT_SEARCH=60/minute
# Header holding the real client IP when behind a trusted edge proxy (e.g. CF-Connecting-IP)
CLIENT_IP_HEADER=
# Reverse proxies in front of the app that append to X-Forwarded-For (1 behind a load balancer)
TRUSTED_PROXY_HOPS=0
# Extra origins allowed to call /api/* (empty = same-origin only)
CORS_ORIGINS=
