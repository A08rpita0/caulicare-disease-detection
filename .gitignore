# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.cache/

# Virtual environments
.venv/
venv/
env/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Logs and temporary files
logs/
*.log
*.part
tmp/
uploads/
.ipynb_checkpoints/

# Datasets and training caches (download separately, see training/README.md)
data/raw/
data/processed/

# Model files: only the deployed model and its metadata are committed
models/*
!models/.gitkeep
!models/README.md
!models/model1.h5
!models/model_metadata.json

# Similarity service: the DINOv2 model (88.5 MB) is downloaded at build time by
# similarity_service/download_model.py. The reference index (similarity_service/index/)
# IS committed: VegNet-derived thumbnails, CC BY 4.0, see its ATTRIBUTION.md.
similarity_service/models/*.onnx
similarity_service/models/*.part

# Frontend / deployment tooling (not used by this project, ignored defensively)
node_modules/
dist/
build/
.vercel/
